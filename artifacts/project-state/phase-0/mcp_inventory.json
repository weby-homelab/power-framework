    {
      "name": "sync_vault",
      "description": "Publish an atomic search-index generation for the configured vault.\n\n``ingest_note`` and ``synthesize_session`` write the note and refresh the\nhierarchical index, but the search database is a separate artifact — until\nit is rebuilt, ``search_vault_tool`` cannot return the note that was just\nsaved. Call this after writing notes.\n\nThe default is ``fts_only=True`` so an agent can close the write/search loop\nwithout downloading or loading an embedding model. Set ``fts_only=False``\nfor the dense index and ``force_rebuild=True`` after changing the embedding\nmodel or dimension. Invalid notes fail closed unless ``allow_partial=True``.\nWhen ``fts_only=True`` would discard an active dense index, the call fails\nclosed unless ``accept_dense_loss=True`` is explicit.\n",
      "parameters": {
        "properties": {
          "fts_only": {
            "default": true,
            "title": "Fts Only",
            "type": "boolean"
          },
          "accept_dense_loss": {
            "default": false,
            "title": "Accept Dense Loss",
            "type": "boolean"
          },
          "force_rebuild": {
            "default": false,
            "title": "Force Rebuild",
            "type": "boolean"
          },
          "allow_partial": {
            "default": false,
            "title": "Allow Partial",
            "type": "boolean"
          },
          "vault_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Vault Path"
          }
        },
        "title": "sync_vaultArguments",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "risk": {
        "local_only": true,
        "egress": "model_download",
        "approval": "caller"
      }
    },
