{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weby-homelab.github.io/power-framework/schemas/doctor-report-v1.json",
  "title": "P.O.W.E.R. doctor report v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "command",
    "status",
    "runtime",
    "configuration",
    "capabilities",
    "embedding",
    "vault",
    "issues",
    "exit_code"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "const": "doctor" },
    "status": { "enum": ["ok", "degraded", "error"] },
    "runtime": { "type": "object" },
    "configuration": { "type": "object" },
    "capabilities": {
      "type": "object",
      "required": [
        "schema_version",
        "source",
        "version",
        "interfaces",
        "search",
        "okf",
        "models",
        "storage",
        "environment",
        "read_only",
        "network_access"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "source": { "const": "power_framework.core.capabilities" },
        "version": { "type": "string" },
        "interfaces": {
          "type": "object",
          "required": ["cli_commands", "mcp_tools", "mcp_tool_contracts"],
          "properties": {
            "cli_commands": { "type": "array", "items": { "type": "string" } },
            "mcp_tools": { "type": "array", "items": { "type": "string" } },
            "mcp_tool_contracts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "annotations", "risk"],
                "properties": {
                  "name": { "type": "string" },
                  "annotations": {
                    "type": "object",
                    "required": [
                      "readOnlyHint",
                      "destructiveHint",
                      "idempotentHint",
                      "openWorldHint"
                    ],
                    "properties": {
                      "readOnlyHint": { "type": "boolean" },
                      "destructiveHint": { "type": "boolean" },
                      "idempotentHint": { "type": "boolean" },
                      "openWorldHint": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  },
                  "risk": {
                    "type": "object",
                    "required": ["local_only", "egress", "approval"],
                    "properties": {
                      "local_only": { "const": true },
                      "egress": { "enum": ["none", "model_download"] },
                      "approval": { "enum": ["none", "caller", "explicit"] }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "search": { "type": "object" },
        "okf": {
          "type": "object",
          "required": ["schema_version", "artifact", "required_fields"],
          "properties": {
            "schema_version": { "const": "power.okf-metadata.v1" },
            "artifact": { "const": "docs/schemas/okf-metadata-v1.json" },
            "required_fields": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "models": { "type": "object" },
        "storage": { "type": "object" },
        "environment": { "type": "object" },
        "read_only": { "const": true },
        "network_access": { "const": false }
      },
      "additionalProperties": false
    },
    "embedding": { "type": "object" },
    "vault": { "type": ["object", "null"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["warning", "error"] },
          "message": { "type": "string" },
          "remediation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "exit_code": { "enum": [0, 1] }
  }
}
