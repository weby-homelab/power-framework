[Unit]
Description=POWER INFRA-1 constrained infrastructure execution broker
Documentation=https://github.com/weby-homelab/power-framework/blob/main/deploy/infra/README.md
Wants=network-online.target
After=network-online.target local-fs.target
ConditionPathExists=/etc/power/infra/profiles.d

[Service]
Type=simple
User=power-infra
Group=power-infra
SupplementaryGroups=power-infra
ExecStart=/usr/bin/python3 -m power_framework.core.infra_broker serve --policy /etc/power/infra/profiles.d --socket /run/power-infra/broker.sock --state /var/lib/power-infra --approvals /etc/power/infra/approvals.json
Restart=on-failure
RestartSec=5s

# The service is opt-in. Installation and enablement are explicit operator work.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
RuntimeDirectory=power-infra
RuntimeDirectoryMode=0750
StateDirectory=power-infra
StateDirectoryMode=0700
ReadWritePaths=/run/power-infra /var/lib/power-infra
ReadOnlyPaths=/etc/power/infra
LoadCredential=power-vault-key:/etc/power/infra/credentials/power-vault

[Install]
WantedBy=multi-user.target
