[Unit]
Description=POWER INFRA-1 constrained infrastructure execution broker
Documentation=https://github.com/weby-homelab/power-framework/blob/main/deploy/infra/README.md
Requires=power-infra-broker.socket
After=power-infra-broker.socket local-fs.target network-online.target
ConditionPathExists=/etc/power/infra/profiles.d
ConditionPathExists=/etc/power/infra/callers.json

[Service]
Type=exec
User=power-infra
Group=power-infra
ExecStartPre=/usr/bin/python3 -E -c "import sys; raise SystemExit(0 if (3, 13) <= sys.version_info[:2] < (3, 15) else 1)"
ExecStartPre=/usr/bin/python3 -E -c "import importlib.metadata as m; raise SystemExit(0 if m.version('power-framework') == '3.7.11' else 1)"
ExecStart=/usr/bin/python3 -E -m power_framework.core.infra_broker serve --policy /etc/power/infra/profiles.d --socket /run/power-infra/broker.sock --state /var/lib/power-infra --approvals /etc/power/infra/approvals.json --caller-allowlist /etc/power/infra/callers.json --socket-activation
Restart=no
KillMode=control-group
LimitCORE=0
LimitNOFILE=256
TasksMax=32
MemoryMax=512M
CPUQuota=50%

# The service is opt-in. Installation and enablement are explicit operator work.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
RuntimeDirectory=power-infra-broker
RuntimeDirectoryMode=0700
Environment=POWER_INFRA_RUNTIME_DIR=/run/power-infra-broker
StateDirectory=power-infra
StateDirectoryMode=0700
ReadWritePaths=/var/lib/power-infra
ReadOnlyPaths=/etc/power/infra /srv/power-vault/source
LoadCredential=power-vault-key:/etc/power/infra/credentials/power-vault
LoadCredential=power-vault-verify-key:/etc/power/infra/credentials/power-vault-verify

[Install]
WantedBy=multi-user.target
