[Unit]
Description=Hourly fail-closed P.O.W.E.R. runtime updater
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/power_auto_updater.py --config /etc/power-updater/power-updater.env
TimeoutStartSec=30min
NoNewPrivileges=false
PrivateTmp=true
StandardOutput=journal
StandardError=journal
